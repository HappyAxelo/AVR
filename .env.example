# ---------------------------------------------------------------
# Frontend. VITE_ vars are bundled into the browser build, so only
# ever put the publishable/anon key here — never the service role.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://vusbutgfaivhodtztsxm.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Supabase Edge Function secrets. Set these in the Supabase
# dashboard under Edge Functions → Secrets, or with:
#   supabase secrets set KEY=value
# They must never appear in the frontend bundle or in this repo
# with real values.
#
#   RESEND_API_KEY   Required to send any email at all.
#   SITE_URL         Public site URL. Confirmation and unsubscribe
#                    links are built from it, so it must be the real
#                    domain in production.
#   ADMIN_EMAIL      Where enquiry notifications go. Optional: falls
#                    back to the first address in admin_users.
#   FROM_EMAIL       Optional. Defaults to Resend's shared test
#                    sender until the AVR domain is verified, then
#                    set it to: AVR <news@yourdomain>
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically — do not set them yourself.
# ---------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SITE_URL=https://your-domain.example
# ADMIN_EMAIL=muyombanohappy@gmail.com
# FROM_EMAIL=AVR <news@your-domain.example>
